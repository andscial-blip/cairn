# Copy to .env.local and fill in. NEVER commit real values.
# Public (safe in the browser): project URL and anon key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel env, never NEXT_PUBLIC_): used only by admin route handlers and scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Max offline session length in hours before the app requires an online re-login.
NEXT_PUBLIC_OFFLINE_SESSION_HOURS=168

# Local/CI only: Postgres used by the db test suite.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cef_test
